      "id": "2c2f0387-cda3-496b-84be-f337e4b77e58",
      "name": "Gemini API (Resume Feedback)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "const feedbackRaw = $('Gemini API (Resume Feedback)').item.json.candidates[0].content.parts[0].text;\nconst studentName = $('Submit Resume Form').item.json[\"Student Name\"] || 'Student';\nconst studentEmail = $('Submit Resume Form').item.json[\"Student Email\"] || 'bussareddyabhishekreddy@gmail.com';\n\nfunction parseSection(text, heading) {\n  const regex = new RegExp(`##\\\\s*${heading}[\\\\s\\\\S]*?(?=##|$)`, 'i');\n  const match = text.match(regex);\n  if (!match) return '<p style=\"color:#9ca3af;\">Not available</p>';\n  let content = match[0].replace(new RegExp(`##\\\\s*${heading}`, 'i'), '').trim();\n  content = content.replace(/^[\\-\\*]\\s+/gm, '\u2022 ');\n  content = content.replace(/\\n/g, '<br>');\n  return content;\n}\n\nconst skills = parseSection(feedbackRaw, 'Skills Extracted');\nconst weaknesses = parseSection(feedbackRaw, 'Weaknesses & Gaps');\nconst suggestions = parseSection(feedbackRaw, 'Suggestions for Improvement');\nconst atsRaw = parseSection(feedbackRaw, 'ATS Score');\n\nconst scoreMatch = atsRaw.match(/(\\d{1,3})/);\nconst atsScore = scoreMatch ? parseInt(scoreMatch[1]) : 'N/A';\nconst scoreColor = typeof atsScore === 'number' ? (atsScore >= 70 ? '#22c55e' : atsScore >= 40 ? '#f59e0b' : '#ef4444') : '#6b7280';\nconst today = new Date().toISOString().split('T')[0];\n\nconst htmlBody = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin:0; padding:0; background-color:#f0f2f5; font-family:'Segoe UI',Roboto,Arial,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f0f2f5; padding:32px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,0.08);\">\n          <tr>\n            <td style=\"background:linear-gradient(135deg,#0ea5e9 0%,#6366f1 100%); padding:40px 32px; text-align:center;\">\n              <h1 style=\"margin:0; color:#ffffff; font-size:28px; font-weight:700; letter-spacing:-0.5px;\">\ud83d\udcc4 Resume Analysis Report</h1>\n              <p style=\"margin:8px 0 0; color:rgba(255,255,255,0.85); font-size:14px;\">Prepared for ${studentName} &bull; ${today}</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:24px 32px 16px; text-align:center;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f9fafb; border-radius:12px;\">\n                <tr>\n                  <td style=\"padding:24px; text-align:center;\">\n                    <p style=\"margin:0 0 8px; font-size:12px; color:#9ca3af; text-transform:uppercase; letter-spacing:2px; font-weight:600;\">ATS Compatibility Score</p>\n                    <p style=\"margin:0; font-size:56px; font-weight:800; color:${scoreColor}; line-height:1;\">${atsScore}${typeof atsScore === 'number' ? '<span style=\"font-size:24px; color:#9ca3af;\">/100</span>' : ''}</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 32px 16px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f0fdf4; border-radius:12px; border-left:4px solid #22c55e;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <h2 style=\"margin:0 0 12px; font-size:16px; color:#16a34a; text-transform:uppercase; letter-spacing:1px;\">\u2705 Skills Extracted</h2>\n                    <div style=\"font-size:14px; color:#4b5563; line-height:1.8;\">${skills}</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 32px 16px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#fef2f2; border-radius:12px; border-left:4px solid #ef4444;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <h2 style=\"margin:0 0 12px; font-size:16px; color:#dc2626; text-transform:uppercase; letter-spacing:1px;\">\u26a0\ufe0f Weaknesses & Gaps</h2>\n                    <div style=\"font-size:14px; color:#4b5563; line-height:1.8;\">${weaknesses}</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 32px 16px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#eff6ff; border-radius:12px; border-left:4px solid #3b82f6;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <h2 style=\"margin:0 0 12px; font-size:16px; color:#2563eb; text-transform:uppercase; letter-spacing:1px;\">\ud83d\udca1 Suggestions</h2>\n                    <div style=\"font-size:14px; color:#4b5563; line-height:1.8;\">${suggestions}</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"background-color:#f9fafb; padding:24px 32px; text-align:center; border-top:1px solid #e5e7eb;\">\n              <p style=\"margin:0; font-size:13px; color:#9ca3af;\">Keep improving your resume, ${studentName}! \ud83d\ude80</p>\n              <p style=\"margin:4px 0 0; font-size:12px; color:#d1d5db;\">AI Placement Prep Assistant &bull; Powered by Gemini</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\nreturn {\n  studentName,\n  studentEmail,\n  atsScore,\n  htmlBody\n};"
      },
