    {
      "parameters": {
        "jsCode": "const aptitude = $('HTTP Request (Aptitude)').item.json.candidates[0].content.parts[0].text;\nconst coding = $('HTTP Request (Coding)').item.json.candidates[0].content.parts[0].text;\nconst tip = $('HTTP Request (Interview Tip)').item.json.candidates[0].content.parts[0].text;\nconst student = $('Loop Over Students').item.json;\nconst today = new Date().toISOString().split('T')[0];\n\nconst aptitudeHtml = aptitude.replace(/\\n/g, '<br>');\nconst codingHtml = coding.replace(/\\n/g, '<br>');\nconst tipHtml = tip.replace(/\\n/g, '<br>');\n\nconst htmlBody = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin:0; padding:0; background-color:#f0f2f5; font-family:'Segoe UI',Roboto,Arial,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f0f2f5; padding:32px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,0.08);\">\n          <!-- Header -->\n          <tr>\n            <td style=\"background:linear-gradient(135deg,#667eea 0%,#764ba2 100%); padding:40px 32px; text-align:center;\">\n              <h1 style=\"margin:0; color:#ffffff; font-size:28px; font-weight:700; letter-spacing:-0.5px;\">\ud83c\udfaf Daily Placement Prep</h1>\n              <p style=\"margin:8px 0 0; color:rgba(255,255,255,0.85); font-size:14px;\">${today}</p>\n            </td>\n          </tr>\n          <!-- Greeting -->\n          <tr>\n            <td style=\"padding:32px 32px 16px;\">\n              <p style=\"margin:0; font-size:16px; color:#374151;\">Hello <strong style=\"color:#667eea;\">${student.Name}</strong>,</p>\n              <p style=\"margin:8px 0 0; font-size:14px; color:#6b7280;\">Here is your personalized daily placement preparation package.</p>\n            </td>\n          </tr>\n          <!-- Aptitude Section -->\n          <tr>\n            <td style=\"padding:0 32px 16px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f8f0ff; border-radius:12px; border-left:4px solid #8b5cf6;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <h2 style=\"margin:0 0 12px; font-size:16px; color:#7c3aed; text-transform:uppercase; letter-spacing:1px;\">\ud83e\uddee Aptitude Question</h2>\n                    <div style=\"font-size:14px; color:#4b5563; line-height:1.7;\">${aptitudeHtml}</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <!-- Coding Section -->\n          <tr>\n            <td style=\"padding:0 32px 16px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f0fdf4; border-radius:12px; border-left:4px solid #22c55e;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <h2 style=\"margin:0 0 12px; font-size:16px; color:#16a34a; text-transform:uppercase; letter-spacing:1px;\">\ud83d\udcbb Coding Challenge</h2>\n                    <div style=\"font-size:14px; color:#4b5563; line-height:1.7;\">${codingHtml}</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <!-- Interview Tip Section -->\n          <tr>\n            <td style=\"padding:0 32px 16px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#eff6ff; border-radius:12px; border-left:4px solid #3b82f6;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <h2 style=\"margin:0 0 12px; font-size:16px; color:#2563eb; text-transform:uppercase; letter-spacing:1px;\">\ud83d\udde3\ufe0f Interview Tip</h2>\n                    <div style=\"font-size:14px; color:#4b5563; line-height:1.7;\">${tipHtml}</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <!-- Motivational Quote -->\n          <tr>\n            <td style=\"padding:0 32px 24px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#fefce8; border-radius:12px; text-align:center;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <p style=\"margin:0; font-size:18px; color:#a16207; font-style:italic;\">\u2728 &ldquo;Success comes from consistent preparation.&rdquo;</p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"background-color:#f9fafb; padding:24px 32px; text-align:center; border-top:1px solid #e5e7eb;\">\n              <p style=\"margin:0; font-size:13px; color:#9ca3af;\">Best Wishes! \ud83d\ude80</p>\n              <p style=\"margin:4px 0 0; font-size:12px; color:#d1d5db;\">AI Placement Prep Assistant &bull; Powered by Gemini</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\nreturn {\n  student_name: student.Name,\n  student_email: student.Email,\n  row_number: student.row_number || 2,\n  aptitude,\n  coding,\n  interview_tip: tip,\n  date: today,\n  htmlBody\n};"
