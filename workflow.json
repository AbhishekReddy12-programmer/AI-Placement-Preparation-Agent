    {
      "parameters": {
        "jsCode": "const pdfText = ($json.text || \"\").replace(/[\\x00-\\x1F]/g, \" \");\n\nconst promptText = `Analyze this resume content and provide actionable feedback. Structure your response EXACTLY in these sections with these exact headings:\n\n## Skills Extracted\nList the key skills found in the resume as bullet points.\n\n## Weaknesses & Gaps\nList areas of improvement or gaps as bullet points.\n\n## Suggestions for Improvement\nProvide concrete recommendations as bullet points.\n\n## ATS Score\nProvide an estimated ATS compatibility score out of 100 as a single number followed by a brief explanation.\n\nResume Content:\n` + pdfText;\n\nconst bodyObj = {\n  contents: [\n    {\n      parts: [\n        { text: promptText }\n      ]\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    ...$json,\n    bodyString: JSON.stringify(bodyObj)\n  }\n}];"
      },
      "id": "e4d3c2b1-0a9b-8c7d-6e5f-4a3b2c1d0e9f",
      "name": "Prepare Resume Prompt",
